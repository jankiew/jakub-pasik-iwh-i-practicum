doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Job Applications
    a(href="/update-cobj") Add to this table

    if error
      p(style="color:red") Error: #{error}
    else if data && data.length
      .cards
        each record in data
          .card
            h2.card__name #{record.properties.application_name}
            p.card__availability Hours per week: #{record.properties.availability_hours_per_week || '-'}
            p.card__rate Hourly rate: #{record.properties.hourly_rate || '-'}
            p.card__linkedin
              if record.properties.linkedin_profile
                a(href=record.properties.linkedin_profile target="_blank") LinkedIn Profile
              else
                | No LinkedIn
    else
      p No records found. Use "Add to this table" to create one.
