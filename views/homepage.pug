doctype html
html
  head
    meta(charset="utf-8")
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1= title
    a(href="/update-cobj") Add to this table

    if error
      p(style="color:red") Error: #{error}
    else if data && data.length
      table
        thead
          tr
            th ID
            th Application Name
            th Availability (hrs/week)
            th Hourly Rate
            th LinkedIn Profile
        tbody
          each record in data
            tr
              td= record.id
              td= record.properties.application_name || '-'
              td= record.properties.availability_hours_per_week || '-'
              td= record.properties.hourly_rate || '-'
              td
                if record.properties.linkedin_profile
                  a(href=record.properties.linkedin_profile target="_blank")= record.properties.linkedin_profile
                else
                  | -
    else
      p No records found. Use "Add to this table" to create one.
